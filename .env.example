# Copy this file to ".env" and fill in your Supabase project values.
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# NOTE: Never put the service_role key here — it stays secret on the server only.
# Until these two values are set, the app runs in local demo mode (browser storage).
